#!/usr/sbin/nft -f
{{ ansible_managed | comment }}
# ============================================================
# nftables — règles pour le nœud OpenBao {{ inventory_hostname }}
# Politique par défaut : DROP en input. Tout est explicitement autorisé.
# ============================================================

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority filter; policy drop;

        # Loopback
        iif lo accept

        # Sessions établies
        ct state established,related accept
        ct state invalid drop

        # ICMP basique
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # SSH (ne pas se couper l'accès)
        tcp dport 22 accept

        # API OpenBao : 8200/tcp ouvert à tout le monde
        tcp dport {{ openbao_api_port }} accept

        # Cluster Raft : 8201/tcp restreint aux IPs des autres pairs OpenBao
{% for host in groups['openbao'] %}
{% if host != inventory_hostname %}
        ip saddr {{ hostvars[host].ansible_host }} tcp dport {{ openbao_cluster_port }} accept
{% endif %}
{% endfor %}

        # Tout le reste journalisé puis dropé
        log prefix "nft drop input: " level warn limit rate 5/minute
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
