# {{ ansible_managed }}
# Policy "secrets-ro-{{ projet }}" — lecture seule sur le mount KV v2 du projet {{ projet }}.
# Pour les workloads qui consomment des secrets sans avoir besoin de les modifier.

# Lecture des data
path "kv-{{ projet }}/data/*" {
  capabilities = ["read"]
}

# Lecture des métadonnées + listing (utile pour découverte des secrets disponibles)
path "kv-{{ projet }}/metadata/*" {
  capabilities = ["read", "list"]
}
path "kv-{{ projet }}/metadata" {
  capabilities = ["list"]
}
