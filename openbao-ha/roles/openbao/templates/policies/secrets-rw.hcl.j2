# {{ ansible_managed }}
# Policy "secrets-rw-{{ projet }}" — lecture/écriture sur le mount KV v2 du projet {{ projet }}.
# Pour les CI/CD et apps qui gèrent leurs propres secrets.

# CRUD sur les data du projet
path "kv-{{ projet }}/data/*" {
  capabilities = ["create", "read", "update", "delete"]
}

# Soft-delete / undelete / destroy de versions précises
path "kv-{{ projet }}/delete/*" {
  capabilities = ["update"]
}
path "kv-{{ projet }}/undelete/*" {
  capabilities = ["update"]
}
path "kv-{{ projet }}/destroy/*" {
  capabilities = ["update"]
}

# Métadonnées (versions, custom_metadata, max_versions)
path "kv-{{ projet }}/metadata/*" {
  capabilities = ["read", "list", "delete"]
}

# Listing du contenu
path "kv-{{ projet }}/metadata" {
  capabilities = ["list"]
}
