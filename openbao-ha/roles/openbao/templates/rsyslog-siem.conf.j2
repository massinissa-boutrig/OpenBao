# {{ ansible_managed }}
# Forwarder rsyslog : audit OpenBao + sshd → SIEM TCP+TLS.
#
# Source : facility AUTH (audit OpenBao + sshd).
# Cible  : {{ openbao_siem_host }}:{{ openbao_siem_port }} (TLS).
#
# Note : plus de forwarding HAProxy depuis ces nœuds — le LB est Octavia
# (managé par OpenStack), ses logs sont à récupérer côté contrôleur Octavia.

# Charger les modules TLS
module(load="omfwd")
module(load="imfile")

# Configuration TLS globale (certs serveur SIEM)
global(
  defaultNetstreamDriver="gtls"
  defaultNetstreamDriverCAFile="{{ openbao_siem_ca_path }}"
)

# Forward facility AUTH (audit OpenBao + sshd) vers le SIEM
auth.* action(
  type="omfwd"
  target="{{ openbao_siem_host }}"
  port="{{ openbao_siem_port }}"
  protocol="tcp"
  StreamDriver="gtls"
  StreamDriverMode="1"
  StreamDriverAuthMode="x509/name"
  StreamDriverPermittedPeers="{{ openbao_siem_host }}"
  Action.ResumeRetryCount="-1"
  queue.type="LinkedList"
  queue.size="50000"
  queue.filename="openbao-siem-spool"
  queue.saveOnShutdown="on"
)

