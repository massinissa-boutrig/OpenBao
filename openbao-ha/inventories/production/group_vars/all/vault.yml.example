---
# ============================================================
# Squelette du fichier Ansible Vault — à chiffrer en production.
#
# Création :
#   ansible-vault create inventories/production/group_vars/all/vault.yml
#
# Édition :
#   ansible-vault edit   inventories/production/group_vars/all/vault.yml
#
# Lancer un playbook :
#   ansible-playbook playbooks/site.yml --ask-vault-pass
# ============================================================
#
# ⚠️ IMPORTANT — NE PAS METTRE DANS CE VAULT :
#   - Les 5 unseal keys Shamir (à distribuer à 5 opérateurs distincts,
#     coffres individuels offline type KeePass / YubiKey).
#   - Le root token initial (à révoquer dès qu'une AppRole admin existe).
#
# Ces secrets ne doivent JAMAIS être stockés dans un endroit unique
# accessible à tout le monde — c'est le principe même du seal Shamir.
# ============================================================

# Passphrase de la clé privée de la CA interne (générée par playbooks/pki.yml).
# Doit être longue (32+ caractères), aléatoire, conservée au coffre.
pki_ca_passphrase: "CHANGEME_long_random_passphrase_for_internal_CA_private_key"

# Mot de passe pour la page stats HAProxy (user "admin").
haproxy_stats_password: "CHANGEME_haproxy_stats_admin_password"

# Mot de passe partagé VRRP entre HAProxy MASTER et BACKUP d'un même DC.
# Authentification PASS — 8 caractères max (limitation keepalived/VRRP).
keepalived_auth_pass: "CHANGEM8"

# Token OpenBao dédié au playbook backup.yml.
# Créé après init via :
#   bao token create -policy=snapshot-policy -orphan -ttl=8760h
# La policy snapshot-policy doit autoriser sys/storage/raft/snapshot.
openbao_backup_token: "CHANGEME_dedicated_backup_token"

# ============================================================
# Auto-unseal STATIC (optionnel — uniquement si openbao_auto_unseal_enabled=true)
# ============================================================
# ⚠️ DANGER : ces clés sont l'équivalent du seuil Shamir. Quiconque
# possède la passphrase ansible-vault possède de fait OpenBao.
# Distribuer ces 3 clés à 3 opérateurs ne sert à RIEN si elles sont
# regroupées ici — c'est le contraire du principe Shamir.
#
# Justification de ne mettre QUE le seuil (3) et pas les 5 :
#   - Les 2 clés restantes sont distribuées à 2 opérateurs dans des
#     coffres offline (ex: KeePass + YubiKey) pour permettre un unseal
#     d'urgence si la passphrase Ansible Vault est compromise/perdue.
#   - C'est un compromis : on perd l'isolation Shamir mais on garde
#     une voie de récupération hors-Ansible.
#
# Format : liste de strings base64 (telles que retournées par
# `bao operator init -format=json | jq -r '.unseal_keys_b64[]'`).
# ============================================================
openbao_unseal_keys:
  - "CHANGEME_unseal_key_1_base64"
  - "CHANGEME_unseal_key_2_base64"
  - "CHANGEME_unseal_key_3_base64"
