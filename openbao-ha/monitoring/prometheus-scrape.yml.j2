# {{ ansible_managed }}
# Prometheus scrape config — à intégrer dans prometheus.yml du serveur
# de monitoring (sous scrape_configs:).
#
# OpenBao expose ses métriques sur /v1/sys/metrics?format=prometheus.
# Authentification : token avec policy "auditor" (read sur sys/metrics).

scrape_configs:
  - job_name: openbao
    metrics_path: /v1/sys/metrics
    params:
      format: ['prometheus']
    scheme: https
    scrape_interval: 30s
    scrape_timeout: 10s
    tls_config:
      ca_file: /etc/prometheus/openbao-ca.crt
      insecure_skip_verify: false
    bearer_token_file: /etc/prometheus/openbao-auditor.token
    static_configs:
      - targets:
          - bao-node-1.intra:8200
          - bao-node-2.intra:8200
          - bao-node-3.intra:8200
        labels:
          service: openbao
          cluster: openbao-prod

  # Métriques Octavia : fournies par openstack-exporter
  # (https://github.com/openstack-exporter/openstack-exporter) à déployer
  # côté serveur de monitoring avec des credentials Keystone lecture-seule.
  # Le job ci-dessous suppose que l'exporter tourne sur monitoring.intra:9180.
  - job_name: octavia
    metrics_path: /metrics
    scheme: http
    scrape_interval: 60s
    static_configs:
      - targets:
          - monitoring.intra:9180
        labels:
          service: octavia
          cluster: openbao-prod
